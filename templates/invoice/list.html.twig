<!DOCTYPE html>
<html>
<head><title>Invoices</title></head>
<body>
    <h1>All Invoices</h1>
    <ul>
    {% for invoice in invoices %}
        <li>
            <a href="{{ path('invoice_show', {id: invoice.id}) }}">
                Invoice #{{ invoice.id }} — {{ invoice.total }} € ({{ invoice.status }})
            </a>
        </li>
    {% else %}
        <li>No invoices found.</li>
    {% endfor %}
    </ul>
</body>
</html>
